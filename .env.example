# Copy to .env and fill in real values. Never commit .env.

# Postgres — service registry, investigation history
POSTGRES_USER=fleet
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fleet_monitor

# ClickHouse — log storage and search
CLICKHOUSE_USER=fleet
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=fleet_monitor

# Neo4j — dependency graph (user is fixed to "neo4j")
NEO4J_PASSWORD=changeme12345

# InfluxDB 3 runs with --without-auth for local dev (single-node learning
# platform, no external exposure). Revisit if that stops being true.

# Anthropic — the investigation loop's model client (server/agent/model-client.js)
ANTHROPIC_API_KEY=
# Optional overrides — defaults match server/agent/model-client.js
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_INPUT_PRICE_PER_MILLION=3
# ANTHROPIC_OUTPUT_PRICE_PER_MILLION=15
